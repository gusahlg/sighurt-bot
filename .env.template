# Fill these in, save as ~/discord-bot/.env, then `chmod 600 ~/discord-bot/.env`.

# Discord bot token (https://discord.com/developers/applications -> Bot -> Token).
DISCORD_TOKEN=

# Application ID (same dev portal, General Information page).
DISCORD_APPLICATION_ID=

# Path to the sqlite database — leave as-is unless you moved it.
DATABASE_URL=sqlite:data/bot.db

# Log level.
RUST_LOG=info

# Shared secret for the SuperSighurt LLM server on the desktop.
# Read from desktop:  cat ~/.config/sighurt-llm.env
# (paste the value after the `=` from SIGHURT_API_KEY).
LLM_API_KEY=
