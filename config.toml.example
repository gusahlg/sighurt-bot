# Discord Moderation Bot Configuration

[automod]
# Enable spam detection by default
spam_enabled = true
# Messages per interval to trigger spam detection
spam_threshold = 5
# Interval in seconds for spam detection
spam_interval = 5

# Enable raid protection by default
raid_enabled = true
# Joins per interval to trigger raid mode
raid_threshold = 10
# Interval in seconds for raid detection
raid_interval = 10

[moderation]
# Default reason when none provided
default_reason = "No reason provided"
# Default message delete days for bans (0-7)
default_delete_days = 1

[chat]
# Forward DMs and @-mentions to the SuperSighurt LLM and reply with the result.
# The LLM_API_KEY env var (in the bot's .env file) carries the shared secret.
# `enabled` is the initial state of the runtime toggle — admins listed below
# can flip it without restarting the bot via `!ai on`, `!ai off`, `!ai status`.
enabled = true
# The production stack is co-located; keep model traffic on loopback.
endpoint_url = "http://127.0.0.1:8088"
# Per-request HTTP timeout.
request_timeout_secs = 90
# Discord user IDs allowed to run `!ai on|off`. Leave empty to disable the
# command entirely (status is still readable by anyone).
admin_user_ids = []
# Minimum seconds between chat replies per channel (flood/DoS guard on the chat
# trigger; DMs aren't covered by automod). Must be > 0. Defaults to 2.
min_seconds_between_replies = 2
respond_to_bots = true
max_bot_chain = 3
# Explicit Discord-reply target plus recent ambient conversation supplied to
# the model. Ambient messages are oldest-first and individually truncated.
reply_context_max_chars = 300
recent_context_messages = 12
context_message_max_chars = 400
# Explicit `!search QUERY`, "search the web for QUERY", and "look up QUERY"
# requests retrieve live evidence. Set BRAVE_SEARCH_API_KEY for broad Brave
# search; without it, DuckDuckGo Instant Answers + Wikimedia are used.
web_search_enabled = true
web_search_max_results = 4
web_search_timeout_secs = 12

[filter]
# Two-step word filter on the bot's OWN outgoing chat replies: a lexical
# deny-list screen (racist / harassment / disturbing terms; profanity alone
# is not filtered), then an AI judge for anything the screen flags — so a
# trigger word inside a harmless sentence doesn't censor the reply. Rejected
# replies are never posted; only the person being replied to is notified,
# privately. `enabled` is the boot state of the runtime toggle — the admins
# in chat.admin_user_ids can flip it via `!filter on|off|status`.
enabled = true
# LOCAL judge model behind an OpenAI-compatible chat-completions endpoint —
# ollama (`http://127.0.0.1:11434/v1/chat/completions`), llama.cpp server,
# LM Studio, vLLM all work. The filter is fail-closed: with judge_url unset,
# or the judge unreachable, lexically flagged replies are rejected outright.
# Prefer a guard-class safety classifier (judge_kind = "guard", answers
# safe/unsafe, e.g. `ollama pull llama-guard3:1b`); judge_kind = "instruct"
# sends a yes/no moderation instruction to a generic chat model instead,
# but small instruct models judge near-randomly.
# judge_url = "http://127.0.0.1:11434/v1/chat/completions"
# judge_model = "llama-guard3:1b"
# judge_kind = "guard"
# Per-request judge timeout; generous because ollama cold-loads on first use.
judge_timeout_secs = 45
# Optional extra deny-list terms, one lowercase term per line, `#` comments.
# Multi-word lines match as phrases, single words as whole tokens.
# words_file = "data/filter_words.txt"
