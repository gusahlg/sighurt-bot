[Unit]
Description=SuperSighurt Discord bot (twilight + LLM client)
After=network-online.target sighurt-llm.service
Wants=network-online.target sighurt-llm.service
# Never give up restarting; RestartSteps below backs off instead.
StartLimitIntervalSec=0

[Service]
# notify: the bot sends READY=1 once shards are created, and feeds the
# watchdog below. An old binary without sd-notify will time out under this
# unit — deploy binary and unit together.
Type=notify
WorkingDirectory=%h/discord-bot
ExecStart=%h/discord-bot/target/release/discord-bot
# Wait for the configured chat endpoint (localhost 1.1B or desktop 16B).
# wait_for_llm.sh bounces sighurt-llm only when endpoint_url is localhost.
# "-" so a missing/broken LLM unit doesn't keep the bot (moderation, scraping) down.
ExecStartPre=-%h/discord-bot/scripts/wait_for_llm.sh
EnvironmentFile=%h/discord-bot/.env
# always (not on-failure): the bot exits non-zero on gateway stalls, but a
# spontaneous clean exit should also come back.
Restart=always
RestartSec=5s
RestartSteps=6
RestartMaxDelaySec=300
# Startup can sit behind a flapping network; give identify time to succeed.
TimeoutStartSec=300
# Kill + restart if the process stops pinging (whole-runtime deadlock).
WatchdogSec=180
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
